OPT_SC_ENGINE_BRAKING 0
OPT_STOP 0
TSTART 0
SSTART 0
TSTART_WRITE = TSTART;
TSTOP 16
SSTOP =  SSTART + 1 ;
OPT_DIRECTION 1
*SPEED 50
*TSTOP 16
*TSTART 0
*SSTART 0

