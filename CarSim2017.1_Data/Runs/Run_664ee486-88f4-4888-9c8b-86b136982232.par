PARSFILE
#FullDataName CarSim Run Control`Payload: DLC, Loaded 2000 kg`Alternate Vehicle Data Measurement
#VEHICLECODE Ind_SA
symbol_push  <<s>> 0
symbol_push  <<o>> 0
symbol_push  <<id_run>> Run_664ee486-88f4-4888-9c8b-86b136982232

OPT_ALL_WRITE 0
IOBJECT 0
OPT_INT_METHOD 2
OPT_VS_FILETYPE 3
PARSFILE Animator\Cameras\Camera_045f9b8a-2e8a-4608-8066-fecace521157.par
#BlueLink0 Animator: Camera Setup`RL View, Road Ref. (Frt. Facing)` Road Reference` , Animator camera`Camera_045f9b8a-2e8a-4608-8066-fecace521157

