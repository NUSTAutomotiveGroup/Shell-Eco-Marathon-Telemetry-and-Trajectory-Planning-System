#CheckBox0 0    
#CheckBox1 0    

symbol_push <<hitch_x>> 0
symbol_push <<hitch_y>> 0
symbol_push <<hitch_z>> 0
iunit 1
PARSFILE Vehicles\Assembly\Vehicle_d2d8a7d8-f0b3-47bf-9fde-587ec0957d7e.par
#BlueLink0 Vehicle: Assembly`E-Class, SUV 2017: Single Contact Point Tire` E-Class` , Lead Unit`Vehicle_d2d8a7d8-f0b3-47bf-9fde-587ec0957d7e

