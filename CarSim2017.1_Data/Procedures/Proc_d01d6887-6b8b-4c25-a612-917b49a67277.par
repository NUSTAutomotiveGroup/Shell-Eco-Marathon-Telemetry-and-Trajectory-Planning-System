PARSFILE
#FullDataName Procedures`Lane Departure, Lane Edges from LTARG`ADAS Examples
#CheckBox3 0    
#CheckBox4 0    

#RingCtrl0 1
#RingCtrl1 0
#RingCtrl2 0
OPT_STOP 0
TSTART 0
SSTART 0
TSTART_WRITE = TSTART;
TSTOP 25
SSTOP =  SSTART + 1 ;
OPT_DIRECTION 1
*SPEED 100
*TSTOP 25
*TSTART 0
*SSTART 0
*SSTOP 500

INSTALL_DRIVER_SPEED_CONTROLLER CarSim9
