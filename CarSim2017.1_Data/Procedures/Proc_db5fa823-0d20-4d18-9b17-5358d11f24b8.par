PARSFILE
#FullDataName Procedures`Emergency Braking - Stopped lead car`
#CheckBox3 0    
#CheckBox4 0    

#RingCtrl0 1
#RingCtrl1 1
OPT_STOP 1
TSTART 0
SSTART 0
TSTART_WRITE = TSTART;
TSTOP 10
SSTOP 210
OPT_DIRECTION 0
*SPEED 100
*TSTOP 10
*TSTART 0
*SSTART 0
*SSTOP 210

INSTALL_DRIVER_SPEED_CONTROLLER CarSim9
OPT_SC 3
SPEED_TARGET_COMBINE ADD
