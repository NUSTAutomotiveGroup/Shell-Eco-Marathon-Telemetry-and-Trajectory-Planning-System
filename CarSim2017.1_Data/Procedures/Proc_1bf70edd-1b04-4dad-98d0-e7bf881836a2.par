PARSFILE
#FullDataName Procedures`Small Bump`Driving
#CheckBox3 0    
#CheckBox4 0    

#RingCtrl0 1
#RingCtrl1 1
OPT_STOP 1
TSTART 0
SSTART -10
TSTART_WRITE = TSTART;
TSTOP 5
SSTOP 10
OPT_DIRECTION 0
*SPEED 40
*TSTOP 5
*TSTART 0
*SSTART -10
*SSTOP 10

INSTALL_DRIVER_SPEED_CONTROLLER CarSim9
OPT_SC 3
