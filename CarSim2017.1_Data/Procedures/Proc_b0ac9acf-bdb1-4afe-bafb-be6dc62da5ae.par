PARSFILE
#FullDataName Procedures`Constant Speed for Ext. Driver Control`Driving
#CheckBox3 0    
#CheckBox4 0    

#RingCtrl0 1
#RingCtrl1 0
#RingCtrl2 0
OPT_STOP 0
TSTART 0
SSTART 220
TSTART_WRITE = TSTART;
TSTOP 30
SSTOP =  SSTART + 1 ;
OPT_DIRECTION 1
*SPEED 100
*TSTOP 30
*TSTART 0
*SSTART 220
*SSTOP 2235

INSTALL_DRIVER_SPEED_CONTROLLER CarSim9
OPT_SC 3
SPEED_TARGET_COMBINE ADD
SPEED_TARGET_CONSTANT 0
SPEED_TARGET_S_CONSTANT 100
OPT_SC_ENGINE_BRAKING 0
PARSFILE Control\Steer\StrSW_d02d6236-3489-4162-b8b9-953cdc586f4c.par
