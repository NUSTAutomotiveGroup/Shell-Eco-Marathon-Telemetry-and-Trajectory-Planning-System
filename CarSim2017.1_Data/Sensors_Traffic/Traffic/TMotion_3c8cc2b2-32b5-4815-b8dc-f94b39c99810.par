#CheckBox38 1    

*L ILTARG
*LEAD 100
*TRAIL 50
*HIDE 10
*PATH_ID PATH_ID_DM
*ROAD_ID CURRENT_ROAD_ID
*V 2

IOBJECT_INCREMENT
symbol_add <<o>> 1
SET_DESCRIPTION OBJECT_NAME 2 Vehicles, Variable Speed for AAC, Object #1

PATH_ID_OBJ PATH_ID_DM
ROAD_ID_OBJ CURRENT_ROAD_ID
EQ_DIFFERENTIAL S_OBJ_<<o>> = SPEED_TARGET(S_OBJ_<<o>>,T,2)
