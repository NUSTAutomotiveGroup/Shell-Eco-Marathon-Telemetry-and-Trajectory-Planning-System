PARSFILE
#FullDataName Generic Data Group`Lane Detection, 3 Edges, Based On LTARG`ADAS Sensors and Controls
#VehCode Generic Group
#MiscYellow0
! The sensor must be defined before the
! points of interest, because the X_SENSOR
! parameter is used to locate the points
#ENDMYellow

PARSFILE Sensors_Traffic\Radar\Radar_081f1bcc-1e3b-46a2-bb4b-01e45d3cb284.par
#BlueLink0 ADAS Sensors for Range and Tracking`Lane-Detection, X = -1200, Z = 1450` Forward Facing Sensors` , Link 1`Radar_081f1bcc-1e3b-46a2-bb4b-01e45d3cb284


#MiscYellow1
DEFINE_PARAMETER lane_width = 3.85; m; ...
  Lane width, used to calculate edge locations
PATH_ID_DM = 1
Current_Road_ID = 1 ! No real road yet
#ENDMYellow

#BlueLink1 ` , Link 2` , Link 2` , Link 2`


#BlueLink2 ` , Link 3` , Link 3` , Link 3`


#MiscYellow3
! Road reference path, objects 1 - 5
N_LTARG = N_LTARG + 1
ILTARG = N_LTARG
ltarg_constant = 0
#ENDMYellow

PARSFILE Sensors_Traffic\Traffic\TMotion_36a47c1f-3469-4d09-adda-781014a127f9.par
#BlueLink3 Multiple Moving Objects`5 Lane Edge Markers Based On ILTARG` Points of Interest` , Link 4`TMotion_36a47c1f-3469-4d09-adda-781014a127f9


#MiscYellow4
! First edge to right, objects 6 - 10
N_LTARG = N_LTARG + 1
ILTARG = N_LTARG
EQ_INIT ltarg_constant = -Lane_Width
#ENDMYellow

PARSFILE Sensors_Traffic\Traffic\TMotion_36a47c1f-3469-4d09-adda-781014a127f9.par
#BlueLink4 Multiple Moving Objects`5 Lane Edge Markers Based On ILTARG` Points of Interest` , Link 5`TMotion_36a47c1f-3469-4d09-adda-781014a127f9


#MiscYellow5
! First edge to left, objects 11 - 15
N_LTARG = N_LTARG + 1
ILTARG = N_LTARG
EQ_INIT ltarg_constant = Lane_Width
#ENDMYellow

PARSFILE Sensors_Traffic\Traffic\TMotion_36a47c1f-3469-4d09-adda-781014a127f9.par
#BlueLink5 Multiple Moving Objects`5 Lane Edge Markers Based On ILTARG` Points of Interest` , Link 6`TMotion_36a47c1f-3469-4d09-adda-781014a127f9


PARSFILE Generic\VS_commands\GenVS_cac40fdd-a603-415e-9d8b-7a61f343ec79.par
#BlueLink6 Generic VS Commands`Lane Departure Warning and HUD` ADAS Support` , Link 7`GenVS_cac40fdd-a603-415e-9d8b-7a61f343ec79


#BlueLink7 ` , Link 8` , Link 8` , Link 8`




#EMBEDDED_NOTES
#Define a front-facing lane-detection sensor and 15 moving objects located on lane edges.
#
#The sensor is defined before the objects, because they use the coordinate X_SENSOR to define station S on the lane edge. The links for VS Commands for warnings and HUD  follow the sensor and objects, because it uses sensor detection variables.
#
#Each edge is defined with an LTARG dataset. These are set to constants that are defined with a parameter LANE_WIDTH.
#
#N_LTARG is the number of LTARG datasets that will be shown in the Echo file. The
#default value is 1; it can be set to any positive number up to 100. In this example it is being used to increment the number of target paths being used and shown in the echo files.
#
#END_EMBEDDED_NOTES

LOG_ENTRY Used Dataset: Generic Data Group; { ADAS Sensors and Controls } Lane Detection, 3 Edges, Based On LTARG
#Library : Generic Data Group
#DataSet : Lane Detection, 3 Edges, Based On LTARG
#Category: ADAS Sensors and Controls
#FileID  : GenGrp_87d8bfc0-6c0b-4696-a36b-2376eef466e1
#Product : CarSim 2017.1
#VehCode Generic Group

