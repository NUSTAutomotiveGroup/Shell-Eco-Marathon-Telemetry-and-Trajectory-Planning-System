  align_x center
  align_y bottom
  size_mode absolute
  place_mode absolute
  location 0 0 128 128
  opacity MagS<<s>>_1
  image_file Animator\3D_shape_files_CS\dashboard\Icons\ACC\Distance_01.png
END_ENTITY hud_image ACC_Distance_1

