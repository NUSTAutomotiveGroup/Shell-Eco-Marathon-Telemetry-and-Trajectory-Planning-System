PARSFILE
#FullDataName Generic Data Lists`ACC Icons for Long Lead`HUD Indicators
#VehCode Generic Lists
#MiscYellow0
ADD_ENTITY hud_image ACC_base
  align_x center
  align_y bottom
  size_mode absolute
  place_mode absolute
  location 0 0 128 128
  image_file Animator\3D_shape_files_CS\dashboard\Icons\ACC\Base.png
END_ENTITY hud_image ACC_base

ADD_ENTITY hud_image ACC_Car_Front
  align_x center
  align_y bottom
  size_mode absolute
  place_mode absolute
  location 0 0 128 128
  opacity MagS<<s>>_1
  image_file Animator\3D_shape_files_CS\dashboard\Icons\ACC\Car_Detected.png
END_ENTITY hud_image ACC_Car_Front

ADD_ENTITY hud_image ACC_Brakes
  align_x center
  align_y bottom
  size_mode absolute
  place_mode absolute
  location 0 0 128 128
  opacity Bk_Stat
  image_file Animator\3D_shape_files_CS\dashboard\Icons\ACC\Brakes_ON.png
END_ENTITY hud_image ACC_Brakes
#ENDMYellow


#MiscYellow1
