PARSFILE
#FullDataName Generic Data Lists`Brake Indicator Light`HUD Indicators
#VehCode Generic Lists
#MiscYellow0
ADD_ENTITY hud_image Brake Fill BG
  location 100 10 100 100
  align_x left
  align_y bottom
  size_mode absolute
  place_mode absolute
  image_file Animator\Hud\LIGHT_OFF.dds
END_ENTITY hud_image Brake Fill BG
#ENDMYellow


#MiscYellow1
ADD_ENTITY hud_text Brake Header
  prefix Brake
  location 125 94 100 18
  align_x left
  align_y bottom
  size_mode absolute
  place_mode absolute
  color 1 1 1 1
  align 10
  outline_color .3 .3 .3 0.5
  font VeraMono.ttf
END_ENTITY hud_text Brake Header
#ENDMYellow


#MiscYellow2
ANI_Bk_Stat
WRT_Bk_Stat
ADD_ENTITY hud_image Brake Fill BG
  location 100 10 100 100
  red 1
  green 0
  blue 0
  align_x left
  align_y bottom
  size_mode absolute
  place_mode absolute
  opacity Bk_Stat * 0.65
  image_file Animator\Hud\LIGHT_ON.dds
END_ENTITY hud_image Brake Fill BG
#ENDMYellow



