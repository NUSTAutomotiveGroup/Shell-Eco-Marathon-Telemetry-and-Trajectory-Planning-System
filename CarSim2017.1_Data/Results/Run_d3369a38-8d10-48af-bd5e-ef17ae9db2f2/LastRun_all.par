define_output vis_2wd 1; -; 2wd visibility switch
define_output vis_4wd 0; -; 4wd visibility switch
ADD_ENTITY hud_image 2WD Image
  location 255 17 100 160
  align_x left
  align_y bottom
  size_mode absolute
  place_mode absolute
  opacity vis_2wd
  image_file Animator\HUD\2WD.png
END_ENTITY hud_image 2WD Image
ADD_ENTITY hud_image 4WD Image
  location 255 17 100 160
  align_x left
  align_y bottom
  size_mode absolute
  place_mode absolute
  opacity vis_4wd
  image_file Animator\HUD\4WD_LO.png
END_ENTITY hud_image 4WD Image
