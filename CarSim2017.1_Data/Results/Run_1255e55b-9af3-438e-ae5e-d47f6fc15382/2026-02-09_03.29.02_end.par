!------------------------------------------------------------------------------------
! VEHICLE
!------------------------------------------------------------------------------------
! The instant center of gravity is calculated every time step using the sprung mass
! + axles and wheels + payloads. Output variables for the vehicle such as Vx, Vy,
! Vz, Ax, Ay, and Az are based on the motion of this instant CG for the total laden
! (TL) unit.

! H_CG_TL 369.1834071 ; mm ! CALC -- Height of TL CG
! LX_CG_TL 1165.000841 ; mm ! CALC -- X distance TL CG is behind origin
! Y_CG_TL 6.642372609e-05 ; mm ! CALC -- Y coordinate of TL CG
! M_TL           1140 ; kg ! CALC -- TL mass

!------------------------------------------------------------------------------------
! SPRUNG MASS
!------------------------------------------------------------------------------------
! The following parameters apply for the sprung mass without payloads, designated
! SU (sprung mass unladen). If any payloads are attached, the combined inertia
! properties (SU sprung mass + payloads) are also listed and designated SL (sprung
! mass laden).

H_CG_SU           375 ; mm ! Height of CG of sprung mass, unladen (SU) [I]
LX_CG_SU         1165 ; mm ! X distance SU CG is behind sprung mass origin [I]
Y_CG_SU             0 ; mm ! Y coordinate of SU CG [I]
M_SU             1020 ; kg ! Mass of unladen sprung mass (SU) [I]
IXX_SU          308.6 ; kg-m2 ! Roll inertia for unladen sprung mass [I]
IYY_SU           1020 ; kg-m2 ! Pitch inertia for SU [I]
IZZ_SU           1020 ; kg-m2 ! Yaw inertia for SU [I]
IXY_SU              0 ; kg-m2 ! XY product of inertia for SU [I]
IXZ_SU              0 ; kg-m2 ! XZ product of inertia for SU [I]
IYZ_SU              0 ; kg-m2 ! YZ product of inertia for SU [I]

! N_PAYLOADS        0 ! CALC -- No. of payloads attached to this sprung mass

!------------------------------------------------------------------------------------
! PAYLOADS
!------------------------------------------------------------------------------------
! NLOAD             0 ! CALC -- Number of installed payloads

!------------------------------------------------------------------------------------
! AERODYNAMICS
!------------------------------------------------------------------------------------
! Aerodynamic coefficients are largely defined with the nonlinear Configurable
! Functions xx_AERO_SHAPING (where xx = FX, FY, etc.). Wind speed and direction are
! defined with the functions WIND_HEADING and WIND_SPEED.

D_AIR           1.206 ; kg/m3 ! Air mass density

AREA_AERO         1.6 ; m2 ! Frontal cross-section area
H_REF_AERO          0 ; mm ! Height of aerodynamic reference point
L_REF_AERO       2330 ; mm ! Aerodynamic reference length
X_REF_AERO      -1165 ; mm ! X coordinate of aerodynamic reference point
Y_REF_AERO          0 ; mm ! Y coordinate of aerodynamic reference point

!------------------------------------------------------------------------------------
! SUSPENSION GEOMETRY AND INERTIA
!------------------------------------------------------------------------------------
! Suspension geometry is specified with the following parameters along with some
! nonlinear Configurable Functions that can use tables of measured or simulated
! suspension kinematical relationships. For independent suspensions, these include
! the functions CAMBER, SUSP_DIVE, SUSP_LAT, SUSP_X, and TOE.

! Independent suspension for axle 1
A_CAMBER(1,1)      -1 ; deg ! Static camber for wheel L1 [I]
A_CAMBER(1,2)      -1 ; deg ! Static camber for wheel R1 [I]
A_TOE(1,1)       -0.2 ; deg ! Static camber for wheel L1 [I]
A_TOE(1,2)       -0.2 ; deg ! Static camber for wheel R1 [I]
H_WC(1,1)         330 ; mm ! Design height (Z coord.) of wheel center L1 [I]
H_WC(1,2)         330 ; mm ! Design height (Z coord.) of wheel center R1 [I]
IW(1,1)           0.6 ; kg-m2 ! Spin inertia for wheel L1 [I]
IW(1,2)           0.6 ; kg-m2 ! Spin inertia for wheel R1 [I]
L_TRACK(1)       1480 ; mm ! Track width, wheel-center to wheel-center, axle 1 [I]
LX_AXLE(1)          0 ; mm ! [D] X dist. axle 1 is behind the sprung-mass origin [I]
M_US(1)            60 ; kg ! Unsprung mass for axle 1 [I]
R_US_STR(1)       0.7 ; - ! Steered fraction of unsprung mass, axle 1 [I]
Y_CL_SUSP(1)        0 ; mm ! Y coord. for suspension centerline, axle 1 [I]

! Independent suspension for axle 2
A_CAMBER(2,1)    -1.5 ; deg ! Static camber for wheel L2 [I]
A_CAMBER(2,2)    -1.5 ; deg ! Static camber for wheel R2 [I]
A_TOE(2,1)        0.2 ; deg ! Static camber for wheel L2 [I]
A_TOE(2,2)        0.2 ; deg ! Static camber for wheel R2 [I]
H_WC(2,1)         310 ; mm ! Design height (Z coord.) of wheel center L2 [I]
H_WC(2,2)         310 ; mm ! Design height (Z coord.) of wheel center R2 [I]
IW(2,1)           0.6 ; kg-m2 ! Spin inertia for wheel L2 [I]
IW(2,2)           0.6 ; kg-m2 ! Spin inertia for wheel R2 [I]
L_TRACK(2)       1485 ; mm ! Track width, wheel-center to wheel-center, axle 2 [I]
LX_AXLE(2)       2330 ; mm ! X dist. axle 2 is behind the sprung-mass origin [I]
M_US(2)            60 ; kg ! Unsprung mass for axle 2 [I]
R_US_STR(2)       0.1 ; - ! Steered fraction of unsprung mass, axle 2 [I]
Y_CL_SUSP(2)        0 ; mm ! Y coord. for suspension centerline, axle 2 [I]

!------------------------------------------------------------------------------------
! SUSPENSION SPRINGS AND DAMPERS
!------------------------------------------------------------------------------------
! Suspension springs and dampers are specified with the following parameters, along
! with the nonlinear Configurable Functions CMP_DAMP, CMP_JSTOP, CMP_RSTOP,
! CMP_SPR_SEAT, FD, F_JNC_STOP, F_REB_STOP, FS_COMP, FS_EXT, and MX_AUX. All
! suspension models calculate compliance effects using the functions CC_FX, CI_FY,
! CI_MZ, CS_FY, CS_MZ, and CT_FX. Independent suspensions also use the functions
! CD_MY, C_LAT, and C_LONG.

OPT_JNC_DESIGN(1)   1 ! Specify jounce in the vehicle design condition for axle 1? 0
                      ! -> no, calculate design jounce based on ride spring data, 1
                      ! -> yes, specify JNC_DESIGN explicitly [I]
OPT_EXT_SP(1,1)     0 ! External option for spring L1: 0 -> include internal spring
                      ! (with or without external model), 1 -> disable internal
                      ! spring and use only the external model [I]
OPT_EXT_SP(1,2)     0 ! External spring R1 only? 0 -> no, 1 -> yes [I]
CMP_OFFSET(1,1)     0 ; mm ! Initial compression of external spring L1 [I]
CMP_OFFSET(1,2)     0 ; mm ! Initial compression of external spring R1 [I]
DAUX(1)             0 ; N-m-s/deg ! Auxiliary roll damping, axle 1
FS_OFFSET(1,1)      0 ; N ! Force offset added to static load for spring L1 [I]
FS_OFFSET(1,2)      0 ; N ! Force offset added to static load for spring R1 [I]
! FSA_DES(1) 5001.3915 ; N ! CALC -- Design (unladen) suspension load, axle 1
! FZA_L(1)  5589.7905 ; N ! CALC -- Static ground force, laden, axle 1
! FZA_UL(1) 5589.7905 ; N ! CALC -- Static ground force, unladen, axle 1
JNC_DESIGN(1,1)     0 ; mm ! Jounce in the design condition, spring L1 [I]
JNC_DESIGN(1,2)     0 ; mm ! Jounce in the design condition, spring R1 [I]
L_SPG_ADJ(1,1)      0 ; mm ! Upper seat height adj. for spring L1 [I]
L_SPG_ADJ(1,2)      0 ; mm ! Upper seat height adj. for spring R1 [I]
SPRING_COMP_BETA(1,1) 2 ; mm ! Reference hysteretic compression (1/3 of the
                        ! compression needed to go from the lower force boundary to
                        ! the upper force boundary) for ride spring L1 
SPRING_COMP_BETA(1,2) 2 ; mm ! Ref. hysteretic compression, ride spring R1 
SPRING_EXT_BETA(1,1) 2 ; mm ! Ref. hysteretic extension, ride spring L1
SPRING_EXT_BETA(1,2) 2 ; mm ! Ref. hysteretic extension, ride spring R1

OPT_JNC_DESIGN(2)   1 ! Specify design jounce explicitly for axle 2? [I]
OPT_EXT_SP(2,1)     0 ! External spring L2 only? 0 -> no, 1 -> yes [I]
OPT_EXT_SP(2,2)     0 ! External spring R2 only? 0 -> no, 1 -> yes [I]
CMP_OFFSET(2,1)     0 ; mm ! Initial compression of external spring L2 [I]
CMP_OFFSET(2,2)     0 ; mm ! Initial compression of external spring R2 [I]
DAUX(2)             0 ; N-m-s/deg ! Auxiliary roll damping, axle 2
FS_OFFSET(2,1)      0 ; N ! Force offset added to static load for spring L2 [I]
FS_OFFSET(2,2)      0 ; N ! Force offset added to static load for spring R2 [I]
! FSA_DES(2) 5001.3915 ; N ! CALC -- Design (unladen) suspension load, axle 2
! FZA_L(2)  5589.7905 ; N ! CALC -- Static ground force, laden, axle 2
! FZA_UL(2) 5589.7905 ; N ! CALC -- Static ground force, unladen, axle 2
JNC_DESIGN(2,1)     0 ; mm ! Jounce in the design condition, spring L2 [I]
JNC_DESIGN(2,2)     0 ; mm ! Jounce in the design condition, spring R2 [I]
L_SPG_ADJ(2,1)      0 ; mm ! Upper seat height adj. for spring L2 [I]
L_SPG_ADJ(2,2)      0 ; mm ! Upper seat height adj. for spring R2 [I]
SPRING_COMP_BETA(2,1) 2 ; mm ! Ref. hysteretic compression, ride spring L2 
SPRING_COMP_BETA(2,2) 2 ; mm ! Ref. hysteretic compression, ride spring R2 
SPRING_EXT_BETA(2,1) 2 ; mm ! Ref. hysteretic extension, ride spring L2
SPRING_EXT_BETA(2,2) 2 ; mm ! Ref. hysteretic extension, ride spring R2

!------------------------------------------------------------------------------------
! STEERING
!------------------------------------------------------------------------------------
! The steering system is specified with the following parameters along with the
! nonlinear Configurable Functions F_BOOST_R, GEAR_ROT, M_BOOST_G, M_SW, M_TBAR,
! MZ_PARKING_STEER, RACK_KIN, RACK_TRAVEL, R_STEER_SPEED, STEER_COMP, and
! STEER_KIN. Open-loop steering can be specified with the function STEER_SW (angle
! control) or M_STR_IN (torque control)

OPT_DRIVER_ACTION   1 ! [D] Action of driver model: 1 -> driver model steering is
                      ! applied, 0 -> driver model steering is available as an
                      ! output, but it is not used [I]
OPT_M_SW_CALC       1 ! Steering torque: 0 -> from table, 1 -> calculated (see the
                      ! steering Help document for details) [I]
OPT_POWER           1 ! Power steering? 0 -> No, 1 -> Yes [I]
OPT_STEER_DEF       1 ! Define steer angles: 1 -> with respect to the sprung-mass
                      ! X-Y plane, 0 -> as rotation angle about a kingpin axis [I]
BETA_COL          0.1 ; deg ! Ref hysteretic angle for steering column friction
D_COL          0.0025 ; N-m-s/deg ! Steering column viscous damping
D_TBAR              0 ; N-m-s/deg ! [D] Torsion bar viscous damping
HYS_COL           0.2 ; N-m ! Steering column friction torque
I_GEAR_IN    0.000182 ; kg-m2 ! Steering system inertia
F_BOOST_MAX      3000 ; N ! Maximum power steering boost force
TC_BOOST         0.02 ; s ! Time constant for power steering boost

OPT_STEER_EXT(1)    0 ! Steer model option for axle 1: 0 -> Internal model, 1 -> Not
                      ! steered, 2 -> External gear/rack model, 3 -> External
                      ! except tie-rod linkage, 4 -> Full external model [I]
OPT_RACK(1)         1 ! Steering gear type for axle 1: 0 -> Recirculating ball, 1 ->
                      ! Rack and pinion [I]
A_CASTER(1,1)     3.5 ; deg ! Caster for wheel L1 [I]
A_CASTER(1,2)     3.5 ; deg ! Caster for wheel R1 [I]
A_KPI(1,1)          8 ; deg ! Kingpin inclination for wheel L1 [I]
A_KPI(1,2)          8 ; deg ! Kingpin inclination for wheel R1 [I]
A_MZ_BETA(1,1)      5 ; deg ! Ref. hysteresis angle for L1 parking steer torque
A_MZ_BETA(1,2)      5 ; deg ! Ref. hysteresis angle for R1 parking steer torque
BETA_RACK(1)      0.1 ; mm ! Ref hys. displ. for steering rack friction, axle 1
D_RACK(1)         4.5 ; N-s/mm ! Steering rack viscous damping, axle 1
HYS_RACK(1)       280 ; N ! Steering rack hysteresis, axle 1
L_KPO(1,1)       39.5 ; mm ! Lateral kingpin offset to center of wheel L1 [I]
L_KPO(1,2)       39.5 ; mm ! Lateral kingpin offset to center of wheel R1 [I]
X_KPO(1,1)         -1 ; mm ! X coord. of kingpin at center of wheel L1 [I]
X_KPO(1,2)         -1 ; mm ! X coord. of kingpin at center of wheel R1 [I]

OPT_STEER_EXT(2)    1 ! Steer model option for axle 2: 0 -> Internal model, 1 -> Not
                      ! steered, 2 -> External gear/rack model, 3 -> External
                      ! except tie-rod linkage, 4 -> Full external model [I]

