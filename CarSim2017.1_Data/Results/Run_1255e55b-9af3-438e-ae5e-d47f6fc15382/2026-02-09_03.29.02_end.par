!------------------------------------------------------------------------------------
! NEW VARIABLES DEFINED AT RUN TIME
!------------------------------------------------------------------------------------
DEFINE_PARAMETER AIR_SPEED_REF = 50; km/h ; Reference speed for wind audio
DEFINE_PARAMETER MAX_BRAKE_TORQUE = -50; N-m ; Max engine braking torque for audio
DEFINE_PARAMETER MAX_TORQUE = 265; N-m ; Max engine torque for audio

DEFINE_OUTPUT v_mod3 = 0.0852259; - ; Audio control, wind speed, vol 
DEFINE_OUTPUT v_mod4 = 0.663379; - ; Audio control, wind speed, freq 
DEFINE_OUTPUT v_mod2 = 0; - ; Audio control (power off) 
DEFINE_OUTPUT v_mod1 = 0; - ; Audio control (power on) 

!------------------------------------------------------------------------------------
! EQUATIONS OUT (AT THE END OF EVERY TIME STEP)
!------------------------------------------------------------------------------------
EQ_OUT V_MOD3 = POW(VAIR/AIR_SPEED_REF, 3);
EQ_OUT V_MOD4 = POW(VAIR/AIR_SPEED_REF, 0.5);
EQ_OUT V_MOD2 = IF_GT_0_THEN(M_ENGOUT, 0, POW(M_ENGOUT/MAX_BRAKE_TORQUE, 0.5));
EQ_OUT V_MOD1 = IF_GT_0_THEN(M_ENGOUT, POW(M_ENGOUT/MAX_TORQUE, 0.5), 0);

