                      ! displacement
CS_FY_OFFSET(2,1)   0 ; deg ! Offset added (after gain) to get CS_FY displacement
F_START_CS_FY(2,1)  0 ; N ! Offset subtracted from force
F_SCALE_CS_FY(2,1)  1 ! Scale factor divided into (force - F_START_CS_FY)

