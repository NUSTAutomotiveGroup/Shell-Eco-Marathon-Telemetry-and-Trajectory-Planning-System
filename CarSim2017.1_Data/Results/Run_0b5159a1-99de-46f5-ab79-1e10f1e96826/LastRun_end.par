F_START_CT_FX(1,2)  0 ; N ! Offset subtracted from force
F_SCALE_CT_FX(1,2)  1 ! Scale factor divided into (force - F_START_CT_FX)

CT_FX_COEFFICIENT(2,1) -6.3e-06 ! Coefficient: CT_FX displacement per unit force
                                ! (deg/N), axle 2, left side
CT_FX_GAIN(2,1)     1 ! Gain multiplied with calculated value to get CT_FX
                      ! displacement
CT_FX_OFFSET(2,1)   0 ; deg ! Offset added (after gain) to get CT_FX displacement
F_START_CT_FX(2,1)  0 ; N ! Offset subtracted from force
F_SCALE_CT_FX(2,1)  1 ! Scale factor divided into (force - F_START_CT_FX)

CT_FX_COEFFICIENT(2,2) -6.3e-06 ! Coefficient: CT_FX displacement per unit force
                                ! (deg/N), axle 2, right side
CT_FX_GAIN(2,2)     1 ! Gain multiplied with calculated value to get CT_FX
                      ! displacement
CT_FX_OFFSET(2,2)   0 ; deg ! Offset added (after gain) to get CT_FX displacement
F_START_CT_FX(2,2)  0 ; N ! Offset subtracted from force
F_SCALE_CT_FX(2,2)  1 ! Scale factor divided into (force - F_START_CT_FX)

! C_LAT: Compliance: lateral inward deflection of wheel due to out-of-phase Fy
! (measured at zero steer). C_LAT displacement is a function of force (CONSTANT,
! COEFFICIENT, or TABLE). Alternatively, a custom equation can be defined at runtime.
! C_LAT displacement from the calculation can be adjusted with C_LAT_GAIN and
! C_LAT_OFFSET. Force used in the calculation can be adjusted with F_SCALE_C_LAT and
! F_START_C_LAT. This configurable function supports 4 datasets; if indices shown
! below are not used, e.g., (1,2), the current values of the indices IAXLE and ISIDE
! are used to identify the dataset when reading data.

C_LAT_COEFFICIENT(1,1) 2.2e-05 ! Coefficient: C_LAT displacement per unit force
                               ! (mm/N), axle 1, left side
C_LAT_GAIN(1,1)     1 ! Gain multiplied with calculated value to get C_LAT
                      ! displacement
C_LAT_OFFSET(1,1)   0 ; mm ! Offset added (after gain) to get C_LAT displacement
F_START_C_LAT(1,1)  0 ; N ! Offset subtracted from force
F_SCALE_C_LAT(1,1)  1 ! Scale factor divided into (force - F_START_C_LAT)

C_LAT_COEFFICIENT(1,2) 2.2e-05 ! Coefficient: C_LAT displacement per unit force
                               ! (mm/N), axle 1, right side
C_LAT_GAIN(1,2)     1 ! Gain multiplied with calculated value to get C_LAT
                      ! displacement
C_LAT_OFFSET(1,2)   0 ; mm ! Offset added (after gain) to get C_LAT displacement
F_START_C_LAT(1,2)  0 ; N ! Offset subtracted from force
F_SCALE_C_LAT(1,2)  1 ! Scale factor divided into (force - F_START_C_LAT)

C_LAT_COEFFICIENT(2,1) 9.4e-05 ! Coefficient: C_LAT displacement per unit force
                               ! (mm/N), axle 2, left side
C_LAT_GAIN(2,1)     1 ! Gain multiplied with calculated value to get C_LAT
                      ! displacement
C_LAT_OFFSET(2,1)   0 ; mm ! Offset added (after gain) to get C_LAT displacement
F_START_C_LAT(2,1)  0 ; N ! Offset subtracted from force
F_SCALE_C_LAT(2,1)  1 ! Scale factor divided into (force - F_START_C_LAT)

C_LAT_COEFFICIENT(2,2) 9.4e-05 ! Coefficient: C_LAT displacement per unit force
                               ! (mm/N), axle 2, right side
C_LAT_GAIN(2,2)     1 ! Gain multiplied with calculated value to get C_LAT
                      ! displacement
C_LAT_OFFSET(2,2)   0 ; mm ! Offset added (after gain) to get C_LAT displacement
F_START_C_LAT(2,2)  0 ; N ! Offset subtracted from force
F_SCALE_C_LAT(2,2)  1 ! Scale factor divided into (force - F_START_C_LAT)

! C_LONG: Compliance: longitudinal deflection of wheel due to in-phase Fx (measured
