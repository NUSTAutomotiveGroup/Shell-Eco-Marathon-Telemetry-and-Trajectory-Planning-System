                               ! (mm/N), axle 1, left side
C_LONG_GAIN(1,1)    1 ! Gain multiplied with calculated value to get C_LONG
                      ! displacement
C_LONG_OFFSET(1,1)  0 ; mm ! Offset added (after gain) to get C_LONG displacement
F_START_C_LONG(1,1) 0 ; N ! Offset subtracted from force
F_SCALE_C_LONG(1,1) 1 ! Scale factor divided into (force - F_START_C_LONG)

