CS_FY_OFFSET(1,2)   0 ; deg ! Offset added (after gain) to get CS_FY displacement
F_START_CS_FY(1,2)  0 ; N ! Offset subtracted from force
F_SCALE_CS_FY(1,2)  1 ! Scale factor divided into (force - F_START_CS_FY)

CS_FY_COEFFICIENT(2,1) -1e-07 ! Coefficient: CS_FY displacement per unit force
                              ! (deg/N), axle 2, left side
