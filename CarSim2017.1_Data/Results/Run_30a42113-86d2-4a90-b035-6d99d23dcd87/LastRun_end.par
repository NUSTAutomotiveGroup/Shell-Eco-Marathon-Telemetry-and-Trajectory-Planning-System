CS_MZ_OFFSET(2,2)   0 ; deg ! Offset added (after gain) to get CS_MZ angular
                      ! deflection
M_START_CS_MZ(2,2)  0 ; N-m ! Offset subtracted from moment
M_SCALE_CS_MZ(2,2)  1 ! Scale factor divided into (moment - M_START_CS_MZ)

