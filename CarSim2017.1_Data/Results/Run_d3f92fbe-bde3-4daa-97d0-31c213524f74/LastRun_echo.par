! HEADING_END(1,14) -105 ; deg ! CALC -- Heading at end of segment

SEGMENT_TYPE(1,15)  3 ! 0 -> straight, 1 -> spline table, 2 -> rho, 3 -> radius, 4
                      ! -> clothoid
SEGMENT_RADIUS(1,15) -40 ; m ! Radius of arc; + -> left turn
