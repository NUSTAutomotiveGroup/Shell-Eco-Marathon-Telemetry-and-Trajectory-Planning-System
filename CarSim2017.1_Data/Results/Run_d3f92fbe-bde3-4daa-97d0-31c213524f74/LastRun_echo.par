SEGMENT_TYPE(1,8)   3 ! 0 -> straight, 1 -> spline table, 2 -> rho, 3 -> radius, 4
                      ! -> clothoid
SEGMENT_RADIUS(1,8) -50 ; m ! Radius of arc; + -> left turn
SEGMENT_ARC(1,8)   90 ; deg ! Central angle of arc
