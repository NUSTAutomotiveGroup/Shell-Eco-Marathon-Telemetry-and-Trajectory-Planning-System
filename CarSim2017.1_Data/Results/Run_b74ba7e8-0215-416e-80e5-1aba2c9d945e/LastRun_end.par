 320, 1, 0.5, 0.75, 0.75, 0.75, 1, 1, 1, 0.75, 0.75, 0.75, 0.5, 1
 330, 1, 0.5, 0.75, 0.75, 0.75, 0.75, 0.75, 0.75, 0.75, 0.75, 0.75, 0.5, 1
 340, 1, 0.5, 0.75, 0.75, 0.75, 0.75, 0.75, 0.75, 0.75, 0.75, 0.75, 0.5, 1
ENDDATA
