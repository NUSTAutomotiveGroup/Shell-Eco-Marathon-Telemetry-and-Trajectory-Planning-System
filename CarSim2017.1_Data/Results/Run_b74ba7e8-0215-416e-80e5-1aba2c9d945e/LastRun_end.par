CT_FX_OFFSET(1,2)   0 ; deg ! Offset added (after gain) to get CT_FX displacement
F_START_CT_FX(1,2)  0 ; N ! Offset subtracted from force
F_SCALE_CT_FX(1,2)  1 ! Scale factor divided into (force - F_START_CT_FX)

CT_FX_COEFFICIENT(2,1) 0 ! Coefficient: CT_FX displacement per unit force (deg/N),
