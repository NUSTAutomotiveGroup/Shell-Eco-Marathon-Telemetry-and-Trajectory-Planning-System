PARSFILE Suspensions\Twist_Beam\Twist_Beam_Comp_Lat\TBLat_060c0c33-5a67-473a-8cd9-609f7357fe94.par
#BlueLink23 Suspension: Twist Beam Compliances - Lateral`B-Class, Hatchback - Rear` ` , Twist Beam Compliances (Lateral)`TBLat_060c0c33-5a67-473a-8cd9-609f7357fe94

! Twist beam suspensions have one kinematic degree of freedom: they are constrained at their
! forward end by a pair of bushings to rotate about a transverse axis. All other motions of
! the wheels result from structural deformation of the beam components.

! Some suspensions that may be called "twist beams" are augmented with a lateral locating
! device such as a track bar ("panhard rod") or Watt's link.

! The first category can be treated as a special case of an independent suspension. The
! second is really a special case of a solid axle.

! This example is for the first case.

! ---Roll center---
define_parameter rch_r = 0.0; mm; Roll Center Height
define_parameter slr_ref = 0.0; mm; Static Loaded Radius
define_variable r_loaded2 0.0; mm; Loaded Tire Radius
eq_in r_loaded2 = ((r0(2,1) - CmpT_L2) + (r0(2,2) - CmpT_R2)) / 2;
define_variable rch_cor rch_r; mm; Corrected Roll Center Height
eq_in rch_cor = r_loaded2 - slr_ref + rch_r;
define_variable dist_r l_track(2); mm; Instantaneous distance between tire touch points
eq_out dist_r = pow(pow(Xctc_l2 - Xctc_r2, 2) + pow(Yctc_l2 - Yctc_r2, 2) + pow(Zgnd_l2 - Zgnd_r2, 2), 0.5);
eq_in imp_fzexl2 = (Fy_L2 + Fy_R2) * rch_cor / dist_r;
import imp_fzexl2 vs_add 0
eq_in imp_fzexr2 = (Fy_L2 + Fy_R2) * rch_cor / dist_r * - 1;
import imp_fzexr2 vs_add 0
define_output fjackl2 = imp_fzexl2; N; Jacking Force left side
define_output fjackr2 = imp_fzexr2; N; Jacking Force right side
! Brake moments
define_parameter brk_m_trans = 0; units = -; Fraction of Brake Moment transferred to opposite suspension
eq_in imp_myusm_l2 = brk_m_trans * (my_bk_r2 - my_bk_l2) - 1 * brk_m_trans * (my_bk_l2 - my_bk_r2);
import imp_myusm_l2 vs_add 0
eq_in imp_myusm_r2 = brk_m_trans * (my_bk_l2 - my_bk_r2) - 1 * brk_m_trans * (my_bk_r2 - my_bk_l2);
import imp_myusm_r2 vs_add 0
! Calculate the parallel and opposed parts of each force and moment
define_variable v_fx_par 0; N; Parallel portion of Fx
eq_in v_fx_par = (fx_l2 + fx_r2) / 2;
define_output fx_par = v_fx_par; N; Parallel portion of Fx (Output)
define_variable v_fx_opp 0; N; Opposed portion of Fx
eq_in v_fx_opp = (fx_l2 - fx_r2) / 2;
define_output fx_opp = v_fx_opp; N; Opposed portion of Fx (Output)
define_variable v_fy_par 0; N; Parallel portion of Fy
eq_in v_fy_par = (fy_l2 + fy_r2) / 2;
define_output fy_par = v_fy_par; N; Parallel portion of Fy (Output)
define_variable v_fy_opp 0; N; Opposed portion of Fy
eq_in v_fy_opp = (fy_l2 - fy_r2) / 2;
define_output fy_opp = v_fy_opp; N; Opposed portion of Fy (Output)
define_variable v_fz_par 0; N; Parallel portion of Fz
eq_in v_fz_par = ((fz_l2 + fz_r2) - FZA_UL) / 2;
define_output fz_par = v_fz_par; N; Parallel portion of Fz (Output)
define_variable v_fz_opp 0; N; Opposed portion of Fz
eq_in v_fz_opp = (fz_l2 - fz_r2) / 2;
define_output fz_opp = v_fz_opp; N; Opposed portion of Fz (Output)
define_variable v_my_par 0; N-m; Parallel portion of My
eq_in v_my_par = (my_bk_l2 + my_bk_r2) / 2;
define_output my_par = v_my_par; N-m; Parallel portion of My (Output)
define_variable v_my_opp 0; N-m; Opposed portion of My
eq_in v_my_opp = (my_bk_l2 - my_bk_r2) / 2;
define_output my_opp = v_my_opp; N-m; Opposed portion of My (Output)
define_variable v_mz_par 0; N-m; Parallel portion of Mz
eq_in v_mz_par = (mz_l2 + mz_r2) / 2;
define_output mz_par = v_mz_par; N-m; Parallel portion of Mz (Output)
define_variable v_mz_opp 0; N-m; Opposed portion of Mz
eq_in v_mz_opp = (mz_l2 - mz_r2) / 2;
define_output mz_opp = v_mz_opp; N-m; Opposed portion of Mz (Output)
define_parameter i_fx_p_l I_CP_FX1; deg/N; inclination due to parallel Fx(L)
define_parameter i_fy_p_l I_CP_FY1; deg/N; inclination due to parallel Fy(L)
define_parameter i_fz_p_l I_CP_FZ1; deg/N; inclination due to parallel Fz(L)
define_parameter i_my_p_l I_CP_MY1; deg/N-m; inclination due to parallel My(L)
define_parameter i_mz_p_l I_CP_MZ1; deg/N-m; inclination due to parallel Mz(L)
define_parameter i_fx_p_r I_CP_FX2; deg/N; inclination due to parallel Fx(R)
define_parameter i_fy_p_r I_CP_FY2; deg/N; inclination due to parallel Fy(R)
define_parameter i_fz_p_r I_CP_FZ2; deg/N; inclination due to parallel Fz(R)
define_parameter i_my_p_r I_CP_MY2; deg/N-m; inclination due to parallel My(R)
define_parameter i_mz_p_r I_CP_MZ2; deg/N-m; inclination due to parallel Mz(R)
eq_in ci_fy_offset(2,1) = i_fx_p_l * fx_par + i_fy_p_l * fy_par + i_fz_p_l * fz_par + i_my_p_l * my_par + i_mz_p_l * mz_par;
eq_in ci_fy_offset(2,2) = i_fx_p_r * fx_par + i_fy_p_r * fy_par + i_fz_p_r * fz_par + i_my_p_r * my_par + i_mz_p_r * mz_par;
define_parameter i_fx_o_l I_CO_FX1; deg/N; inclination due to opposed Fx(L)
define_parameter i_fy_o_l I_CO_FY1; deg/N; inclination due to opposed Fy(L)
define_parameter i_fz_o_l I_CO_FZ1; deg/N; inclination due to opposed Fz(L)
define_parameter i_my_o_l I_CO_MY1; deg/N-m; inclination due to opposed My(L)
define_parameter i_mz_o_l I_CO_MZ1; deg/N-m; inclination due to opposed Mz(L)
define_parameter i_fx_o_r I_CO_FX2; deg/N; inclination due to opposed Fx(R)
define_parameter i_fy_o_r I_CO_FY2; deg/N; inclination due to opposed Fy(R)
define_parameter i_fz_o_r I_CO_FZ2; deg/N; inclination due to opposed Fz(R)
define_parameter i_my_o_r I_CO_MY2; deg/N-m; inclination due to opposed My(R)
define_parameter i_mz_o_r I_CO_MZ2; deg/N-m; inclination due to opposed Mz(R)
eq_in ci_fy_offset(2,1) = ci_fy_offset(2,1) + i_fx_o_l * fx_opp + i_fy_o_l * fy_opp + i_fz_o_l * fz_opp + i_my_o_l * my_opp + i_mz_o_l * mz_opp;
eq_in ci_fy_offset(2,2) = ci_fy_offset(2,2) - (i_fx_o_r * fx_opp + i_fy_o_r * fy_opp + i_fz_o_r * fz_opp + i_my_o_r * my_opp + i_mz_o_r * mz_opp);
define_parameter s_fx_p_l S_CP_FX1; deg/N; steer due to parallel Fx(L)
define_parameter s_fy_p_l S_CP_FY1; deg/N; steer due to parallel Fy(L)
define_parameter s_fz_p_l S_CP_FZ1; deg/N; steer due to parallel Fz(L)
define_parameter s_my_p_l S_CP_MY1; deg/N-m; steer due to parallel My(L)
define_parameter s_mz_p_l S_CP_MZ1; deg/N-m; steer due to parallel Mz(L)
define_parameter s_fx_p_r S_CP_FX2; deg/N; steer due to parallel Fx(R)
define_parameter s_fy_p_r S_CP_FY2; deg/N; steer due to parallel Fy(R)
define_parameter s_fz_p_r S_CP_FZ2; deg/N; steer due to parallel Fz(R)
define_parameter s_my_p_r S_CP_MY2; deg/N-m; steer due to parallel My(R)
define_parameter s_mz_p_r S_CP_MZ2; deg/N-m; steer due to parallel Mz(R)
eq_in cs_fy_offset(2,1) = s_fx_p_l * fx_par + s_fy_p_l * fy_par + s_fz_p_l * fz_par + s_my_p_l * my_par + s_mz_p_l * mz_par;
eq_in cs_fy_offset(2,2) = s_fx_p_r * fx_par + s_fy_p_r * fy_par + s_fz_p_r * fz_par + s_my_p_r * my_par + s_mz_p_r * mz_par;
define_parameter s_fx_o_l S_CO_FX1; deg/N; steer due to opposed Fx(L)
define_parameter s_fy_o_l S_CO_FY1; deg/N; steer due to opposed Fy(L)
define_parameter s_fz_o_l S_CO_FZ1; deg/N; steer due to opposed Fz(L)
define_parameter s_my_o_l S_CO_MY1; deg/N-m; steer due to opposed My(L)
define_parameter s_mz_o_l S_CO_MZ1; deg/N-m; steer due to opposed Mz(L)
define_parameter s_fx_o_r S_CO_FX2; deg/N; steer due to opposed Fx(R)
define_parameter s_fy_o_r S_CO_FY2; deg/N; steer due to opposed Fy(R)
define_parameter s_fz_o_r S_CO_FZ2; deg/N; steer due to opposed Fz(R)
define_parameter s_my_o_r S_CO_MY2; deg/N-m; steer due to opposed My(R)
define_parameter s_mz_o_r S_CO_MZ2; deg/N-m; steer due to opposed Mz(R)
eq_in cs_fy_offset(2,1) = cs_fy_offset(2,1) + s_fx_o_l * fx_opp + s_fy_o_l * fy_opp + s_fz_o_l * fz_opp + s_my_o_l * my_opp + s_mz_o_l * mz_opp;
eq_in cs_fy_offset(2,2) = cs_fy_offset(2,2) - (s_fx_o_r * fx_opp + s_fy_o_r * fy_opp + s_fz_o_r * fz_opp + s_my_o_r * my_opp + s_mz_o_r * mz_opp);
define_parameter yd_fx_p_l CLATX_FX1; mm/N; lateral deflection due to parallel Fx(L)
define_parameter yd_fy_p_l CLATX_FY1; mm/N; lateral deflection due to parallel Fy(L)
define_parameter yd_my_p_l CLATX_MY1; mm/N-m; lateral deflection due to parallel My(L)
define_parameter yd_mz_p_l CLATX_MZ1; mm/N-m; lateral deflection due to parallel Mz(L)
define_parameter yd_fx_p_r CLATX_FX2; mm/N; lateral deflection due to parallel Fx(R)
define_parameter yd_fy_p_r CLATX_FY2; mm/N; lateral deflection due to parallel Fy(R)
define_parameter yd_my_p_r CLATX_MY2; mm/N-m; lateral deflection due to parallel My(R)
define_parameter yd_mz_p_r CLATX_MZ2; mm/N-m; lateral deflection due to parallel Mz(R)
eq_in c_lat_offset(2,1) = yd_fx_p_l * fx_par + yd_fy_p_l * fy_par + yd_my_p_l * my_par + yd_mz_p_l * mz_par;
eq_in c_lat_offset(2,2) = yd_fx_p_r * fx_par + yd_fy_p_r * fy_par + yd_my_p_r * my_par + yd_mz_p_r * mz_par;
define_parameter yd_fx_o_l CLATY_FX1; mm/N; lateral deflection due to opposed Fx(L)
define_parameter yd_fy_o_l CLATY_FY1; mm/N; lateral deflection due to opposed Fy(L)
define_parameter yd_my_o_l CLATY_MY1; mm/N-m; lateral deflection due to opposed My(L)
define_parameter yd_mz_o_l CLATY_MZ1; mm/N-m; lateral deflection due to opposed Mz(L)
define_parameter yd_fx_o_r CLATY_FX2; mm/N; lateral deflection due to opposed Fx(R)
define_parameter yd_fy_o_r CLATY_FY2; mm/N; lateral deflection due to opposed Fy(R)
define_parameter yd_my_o_r CLATY_MY2; mm/N-m; lateral deflection due to opposed My(R)
define_parameter yd_mz_o_r CLATY_MZ2; mm/N-m; lateral deflection due to opposed Mz(R)
eq_in c_lat_offset(2,1) = c_lat_offset(2,1) + yd_fx_o_l * fx_opp + yd_fy_o_l * fy_opp + yd_my_o_l * my_opp + yd_mz_o_l * mz_opp;
eq_in c_lat_offset(2,2) = c_lat_offset(2,2) - (yd_fx_o_r * fx_opp + yd_fy_o_r * fy_opp + yd_my_o_r * my_opp + yd_mz_o_r * mz_opp);
define_parameter xd_fx_p_l CLONX_FX1; mm/N; longitudinal deflection due to parallel Fx(L)
define_parameter xd_fy_p_l CLONX_FY1; mm/N; longitudinal deflection due to parallel Fy(L)
define_parameter xd_my_p_l CLONX_MY1; mm/N-m; longitudinal deflection due to parallel My(L)
define_parameter xd_mz_p_l CLONX_MZ1; mm/N-m; longitudinal deflection due to parallel Mz(L)
define_parameter xd_fx_p_r CLONX_FX2; mm/N; longitudinal deflection due to parallel Fx(R)
define_parameter xd_fy_p_r CLONX_FY2; mm/N; longitudinal deflection due to parallel Fy(R)
define_parameter xd_my_p_r CLONX_MY2; mm/N-m; longitudinal deflection due to parallel My(R)
define_parameter xd_mz_p_r CLONX_MZ2; mm/N-m; longitudinal deflection due to parallel Mz(R)
eq_in c_long_offset(2,1) = xd_fx_p_l * fx_par + xd_fy_p_l * fy_par + xd_my_p_l * my_par + xd_mz_p_l * mz_par;
eq_in c_long_offset(2,2) = xd_fx_p_r * fx_par + xd_fy_p_r * fy_par + xd_my_p_r * my_par + xd_mz_p_r * mz_par;
define_parameter xd_fx_o_l CLONY_FX1; mm/N; longitudinal deflection due to opposed Fx(L)
define_parameter xd_fy_o_l CLONY_FY1; mm/N; longitudinal deflection due to opposed Fy(L)
define_parameter xd_my_o_l CLONY_MY1; mm/N-m; longitudinal deflection due to opposed My(L)
define_parameter xd_mz_o_l CLONY_MZ1; mm/N-m; longitudinal deflection due to opposed Mz(L)
define_parameter xd_fx_o_r CLONY_FX2; mm/N; longitudinal deflection due to opposed Fx(R)
define_parameter xd_fy_o_r CLONY_FY2; mm/N; longitudinal deflection due to opposed Fy(R)
define_parameter xd_my_o_r CLONY_MY2; mm/N-m; longitudinal deflection due to opposed My(R)
define_parameter xd_mz_o_r CLONY_MZ2; mm/N-m; longitudinal deflection due to opposed Mz(R)
eq_in c_long_offset(2,1) = c_long_offset(2,1) + xd_fx_o_l * fx_opp + xd_fy_o_l * fy_opp + xd_my_o_l * my_opp + xd_mz_o_l * mz_opp; 
eq_in c_long_offset(2,2) = c_long_offset(2,2) - (xd_fx_o_r * fx_opp + xd_fy_o_r * fy_opp + xd_my_o_r * my_opp + xd_mz_o_r * mz_opp);
