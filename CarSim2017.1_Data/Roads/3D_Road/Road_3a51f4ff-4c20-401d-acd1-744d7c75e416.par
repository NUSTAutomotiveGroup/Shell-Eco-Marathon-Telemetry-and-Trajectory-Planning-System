PARSFILE
#FullDataName Road: 3D Surface (All Properties)`X-Y-Z Edges`
*IMAGE_TYPE PASTED
*IMAGE_PASTED Roads\3D_Road\Road_3a51f4ff-4c20-401d-acd1-744d7c75e416.png
#RingCtrl0 1
#CheckBox0 0    

DEFINE_ROADS 1
IROAD = NROAD
ROAD_ID IROAD
CURRENT_ROAD_ID = ROAD_ID
set_description road_id X-Y-Z Edges
PARSFILE Roads\Edges\RdEdges_b10cf095-b186-4e13-a66f-f071c03ff017.par
