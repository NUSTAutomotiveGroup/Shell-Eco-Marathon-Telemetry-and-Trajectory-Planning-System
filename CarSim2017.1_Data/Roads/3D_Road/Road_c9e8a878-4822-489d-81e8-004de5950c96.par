PARSFILE
#FullDataName Road: 3D Surface (All Properties)`S-Turns w/ Tables`Misc. Curved Roads
*IMAGE_TYPE PASTED
*IMAGE_PASTED Roads\3D_Road\Road_c9e8a878-4822-489d-81e8-004de5950c96.png
#RingCtrl0 1
#CheckBox0 0    

DEFINE_ROADS 1
IROAD = NROAD
ROAD_ID IROAD
CURRENT_ROAD_ID = ROAD_ID
set_description road_id S-Turns w/ Tables
PARSFILE Roads\BuilderSegment\RoadSeg_02a0e86f-7445-43ec-8bc1-5734635c3654.par
#BlueLink0 Path: Segment Builder`S-Turns from Linked Tables` ` , Reference Path`RoadSeg_02a0e86f-7445-43ec-8bc1-5734635c3654

ROAD_PATH_ID = PATH_ID

set_description road_path_id PATH_ID for: S-Turns from Linked Tables
#BlueLink1 ` , Path Elevation` , Path Elevation` , Path Elevation`

#BlueLink2 ` , Miscellaneous` , Miscellaneous` , Miscellaneous`

PARSFILE Roads\Friction\RdMu_25e73395-9471-44b9-9c60-27bd9cc24921.par
#BlueLink3 Road: Friction Map, S-L Grid`Constant: 0.85` Constant` , Friction`RdMu_25e73395-9471-44b9-9c60-27bd9cc24921

PARSFILE Roads\Shapes\RdShape_1fd38aa5-ef33-4683-9674-3ddf6bbbb500.par
#BlueLink4 Road: Animator Surface Shapes`Clothoid S-Turn` Roads` , Road shape definitions`RdShape_1fd38aa5-ef33-4683-9674-3ddf6bbbb500

#BlueLink10 ` , Miscellaneous` , Miscellaneous` , Miscellaneous`

RR_SURF 1
L_CAMERA_FRONT 0.5
L_CAMERA_REAR 0.5
add_reference_frame road_stuff_1
reference_frame_ghosts off
PARSFILE Animator\Groups\Group_4ccae742-4649-427a-8871-7b3629a730a2.par
#BlueLink6 Animator: Group`Partly Cloudy Sky` Skies` , 3D Shapes`Group_4ccae742-4649-427a-8871-7b3629a730a2

add_reference_frame road_stuff_2
reference_frame_ghosts off
PARSFILE Roads\AniGroup\AniRep_9e87b837-4bbe-4910-ab33-c5c61a43b20d.par
#BlueLink7 Road: Animator Repeated Object`Trees (0, 1000)` Trees` , 3D Shapes`AniRep_9e87b837-4bbe-4910-ab33-c5c61a43b20d

add_reference_frame road_stuff_3
reference_frame_ghosts off
#BlueLink8 ` , 3D Shapes` , 3D Shapes` , 3D Shapes`

add_reference_frame road_stuff_4
reference_frame_ghosts off
add_reference_frame road_stuff_5
reference_frame_ghosts off
