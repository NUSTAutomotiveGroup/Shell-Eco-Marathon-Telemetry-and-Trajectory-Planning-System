PARSFILE
#FullDataName Road: Off-Center Elevation Map, S-L Grid`Lane with Curb and Cross-Slope`Gutters, Curbs, Ditches
#CheckBox0 0    

#RingCtrl0 CARPET
#RingCtrl3 1
DEFINE_DZ_TABLES 1 ! add 1 more DZ table
IROAD_DZ = NROAD_DZ ! make this the active table
ROAD_DZ_ID = IROAD_DZ
ROAD_N_DZ = ROAD_N_DZ + 1 ! increment count for the road
IDZ_ROAD = ROAD_N_DZ ! set index for the new ID
RD_DZ_ID = ROAD_DZ_ID ! Specify the user ID
set_description RD_DZ_ID ROAD_DZ_ID for: Lane with Curb and Cross-Slope

#RadioCtrl0 0    
#RadioCtrl1 0    

*3D_XLabel Lateral coordinate (m)
*3D_YLabel Station (m)
*3D_ZLabel Incremental elevation (m)

#DiagramTwo0
*3D_DATA 7, 2 ! columns x rows
ROAD_DZ_CARPET 2D_LINEAR
0, -12, -5, -4.7, -4.6, -4.3, 0, 1
-20, 0, 0.06, 0.06, -0.1, -0.1, 0, 0
20, 0, 0.06, 0.06, -0.1, -0.1, 0, 0
ENDTABLE


#EMBEDDED_NOTES
#This is the 3D surface for the right lane of a straight road, used in the example 3-way intersection.
#
#The elevation is zero at L = 0 (lane edge and road centerline), dropping to 0.1 at -4.3 m. A curb goes up 0.16m  at -4.6.
#
#END_EMBEDDED_NOTES

LOG_ENTRY Used Dataset: Road: Off-Center Elevation Map, S-L Grid; { Gutters, Curbs, Ditches } Lane with Curb and Cross-Slope
#Library : Road: Off-Center Elevation Map, S-L Grid
#DataSet : Lane with Curb and Cross-Slope
#Category: Gutters, Curbs, Ditches
#FileID  : RdMapZ_277c1f17-f99c-4d7c-97ad-705885fe84db
