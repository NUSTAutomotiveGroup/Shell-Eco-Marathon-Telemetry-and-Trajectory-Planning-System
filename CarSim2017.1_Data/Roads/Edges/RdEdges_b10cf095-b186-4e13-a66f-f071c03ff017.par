PARSFILE
#FullDataName Road: X-Y-Z Coordinates of Edges`Looped Road Edges X-Y-Z`
#RingCtrl0 0
#RingCtrl1 0
#RingCtrl2 1
DEFINE_PATHS 1
IPATH = NPATH
PATH_ID = IPATH
DEFINE_XY_TABLES 1
ITAB_XY = NTAB_XY
XY_TABLE_ID = ITAB_XY
DEFINE_DZ_TABLES 1 ! add 1 more DZ table
IROAD_DZ = NROAD_DZ ! make this the active table
ROAD_N_DZ = ROAD_N_DZ + 1 ! increment count for the road
IDZ_ROAD = ROAD_N_DZ ! set index for the new ID
RD_DZ_ID = ROAD_DZ_ID ! Specify the user ID
set_description RD_DZ_ID ROAD_DZ_ID for: Looped Road Edges X-Y-Z

SET_DESCRIPTION PATH_ID Looped Road Edges X-Y-Z
SET_DESCRIPTION XY_TABLE_ID Looped Road Edges X-Y-Z
IPATHSEG = 1
PATH_ID_DM = PATH_ID
SEGMENT_TYPE = 1
XY_SEGMENT_ID = XY_TABLE_ID

#RadioCtrl0 0    
#RadioCtrl1 0    

#CheckBox0 1    
OPT_PATH_LOOP 1

*3D_XLabel Global Z coordinate (m)
*3D_YLabel Global X coordinate (m)
*3D_ZLabel Global Y coordinate (m)

