PARSFILE
#FullDataName Models: Transfer to Local Windows Directory`Simple Run from MATLAB (64-bit)`Running from MATLAB
*USE_ALT_DIR 1
#ALTPATH Extensions\Custom_M
#CheckBox0 0    
OPT_IO_UPDATE 0
#CheckBox1 0    
#CheckBox2 0    
*USE_DIFF_SOLVERS 0

#RingCtrl0 2
OPT_INT_METHOD 2
#RingCtrl1 1
*X64SOLVER 1
#MiscYellow1
simfile simple.sim

*cpar_include Extensions\Custom_M\Simple.m
*cpar_include Extensions\Custom_M\vs_api_def_m.h
*cpar_include Extensions\Custom_M\vs_dll_path.m
#ENDMYellow

LIVE_SERVER_UPDATE_FREQ_MAX 60

#EMBEDDED_NOTES
#This identifies the folder containing an M file that will read the simfile "simple.sim", load the VS solver DLL for the currently selected vehicle, and make the run.
#END_EMBEDDED_NOTES

