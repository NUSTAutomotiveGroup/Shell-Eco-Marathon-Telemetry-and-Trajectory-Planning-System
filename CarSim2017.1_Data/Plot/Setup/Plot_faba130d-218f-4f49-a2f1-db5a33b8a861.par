PARSFILE
#FullDataName Plot: Setup`Distance from Sensor on One Side`ADAS

ADD_ENTITY Plot


PARSFILE Plot\Format\PlotFmt_01028e0f-04b1-4222-bdf3-7848a11f4ae5.par
#CheckBox0 1    


#MiscYellow0
PLOTCHANNELS DisS<<s>>_1, Time

#ENDMYellow

YAXISLABEL <<side>> distance to target - m

#RingCtrl2 Auto
YMaxmin Auto
#RingCtrl3 Auto
XMaxmin Auto
#RingCtrl8 1


PTITLE Distance from Sensor on One Side

END_ENTITY Plot


#EMBEDDED_NOTES
#Use Symbol Stack <<s>> to get closest object to current sensor.
#
#Need to check the box to not truncate to allow the length of the name that includes <<s>>.
#
#<<side>> (for the Y axis title) is either Left or Right.
#END_EMBEDDED_NOTES

LOG_ENTRY Used Dataset: Plot: Setup; { ADAS } Distance from Sensor on One Side
