PARSFILE
#FullDataName Events`B. Spin`Reverse Spin
#CheckBox1 0    
#CheckBox2 0    
#CheckBox3 0    
#CheckBox4 0    
#CheckBox5 1    
#CheckBox6 1    
#CheckBox7 0    

#RingCtrl0 <
#RingCtrl10 1
#RingCtrl11 5
*NAME1 yaw
*VALUE1 yaw_spin


! Reset all open-loop control clocks by setting parameters to current time
TSTART_T_EVENT = T ; ! 2014
T_EVENT_START = T ; ! legacy
TSTART_BRAKES = T ;
TSTART_STEER_TQ = T ;
TSTART_F_BRAKE_PEDAL = T ;
TSTART_PBK_CON = T ;
TSTART_CLUTCH = T ;
TSTART_GEAR = T ;
TSTART_SPEED_CTRL = T ;
TSTART_STEER = T ;
TSTART_THROTTLE = T ;
TSTART_TRANS = T ;
TSTART_WIND = T ;
OPT_INIT_CONFIG 0
OPT_INIT_PATH 0
OPT_INIT_SPEED 0
Opt_SC 0
PARSFILE Control\Throttle\Throttle_768d3744-c109-4ff7-a65b-3b0bea560117.par
#BlueLink18 Control: Throttle (Open Loop)`Constant: 0` Constant` , Throttle`Throttle_768d3744-c109-4ff7-a65b-3b0bea560117

#MiscYellow0
TSTART_STEER T
#ENDMYellow

PARSFILE Control\Gear_at\GearCL_395374af-90fa-4fef-80e1-a8df607bfbef.par
#BlueLink10 Control: Shifting (Closed Loop)`Neutral` ` , Miscellaneous`GearCL_395374af-90fa-4fef-80e1-a8df607bfbef

PARSFILE Control\Steer\StrSW_6856529d-f485-439d-948c-b85a158c4343.par
#BlueLink11 Control: Steering (Open Loop)`Spin` Ramp` , Miscellaneous`StrSW_6856529d-f485-439d-948c-b85a158c4343

DEFINE_EVENT yaw < yaw_spin ; Events\Events_9a50b6f9-88cf-4945-bc5e-37af6198442a.par
#BlueLink0 Events`C. Hard Brake` Reverse Spin` , Events`Events_9a50b6f9-88cf-4945-bc5e-37af6198442a


#EMBEDDED_NOTES
#In this event, the speed control mode is changed to open loop and the throttle is closed.
#
#The driver control is set to open loop and a severe steering maneuver induces a spin.
#
#When the yaw angle falls below yaw_spin (the vehicle is rotating clockwise), the next event is invoked.
#END_EMBEDDED_NOTES

LOG_ENTRY Used Dataset: Events; { Reverse Spin } B. Spin
