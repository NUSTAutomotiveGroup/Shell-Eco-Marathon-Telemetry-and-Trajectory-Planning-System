PARSFILE
#FullDataName Events`B. Let Speed Settle`Go to Constant Speed
#CheckBox1 0    
#CheckBox2 0    
#CheckBox3 0    
#CheckBox4 0    
#CheckBox5 1    
#CheckBox6 1    
#CheckBox7 0    
#CheckBox8 0    

#RingCtrl0 >
#RingCtrl10 1
#RingCtrl11 1
*NAME1 T_EVENT
*VALUE1 3
*SPEED vx


! Reset all open-loop control clocks by setting parameters to current time
TSTART_T_EVENT = T ; ! 2014
T_EVENT_START = T ; ! legacy
TSTART_BRAKES = T ;
TSTART_STEER_TQ = T ;
TSTART_F_BRAKE_PEDAL = T ;
TSTART_PBK_CON = T ;
TSTART_CLUTCH = T ;
TSTART_GEAR = T ;
TSTART_SPEED_CTRL = T ;
TSTART_STEER = T ;
TSTART_THROTTLE = T ;
TSTART_TRANS = T ;
TSTART_WIND = T ;
OPT_INIT_CONFIG 0
OPT_INIT_PATH 0
OPT_INIT_SPEED 0
INSTALL_DRIVER_SPEED_CONTROLLER 2014
Opt_SC 3
OPT_SC 3
SPEED_TARGET_COMBINE ADD
SPEED_TARGET_CONSTANT 0
SPEED_TARGET_S_CONSTANT vx
OPT_SC_ENGINE_BRAKING 0
PARSFILE Control\Throttle\Throttle_768d3744-c109-4ff7-a65b-3b0bea560117.par
