iside 2
symbol_set <<side>> R
*P_L1 0
PBK_DL_COEFFICIENT 0
PBK_DL_COMBINE MULTIPLY
PBK_DL_FZ_CONSTANT 1
TC_L1 0.3
TC_BK 0.3
OPT_BK_DYN 1
*TQ_L1 0
MY_BRAKE_COEFFICIENT 0

