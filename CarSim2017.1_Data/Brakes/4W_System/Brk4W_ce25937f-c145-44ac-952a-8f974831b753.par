PARSFILE
#FullDataName Brakes: Four-Wheel System`SUV, Full Size w/ ABS`Pickup Trucks and SUVs
#CheckBox1 0    
#RingCtrl0 2
#RingCtrl1 2
#RingCtrl2 1
#RingCtrl4 1
#RingCtrl6 1
#RingCtrl8 1
#RingCtrl10 1
#RingCtrl12 1
#RingCtrl14 0
OPT_BK_PEDAL 0
TL_L1 0
TL_L2 0

iaxle 1
iside 1
symbol_push <<ax_bk>> <<axle>>
symbol_push <<side>> L
TLAG_BK 0
*P_L1 1
PBK_DL_COEFFICIENT 1
PBK_DL_COMBINE MULTIPLY
PBK_DL_FZ_CONSTANT 1
TC_L1 0.06
TC_BK 0.06
OPT_BK_DYN 1
*TQ_L1 500
MY_BRAKE_COEFFICIENT 500

INSTALL_ABS_CONTROLLER
OPT_ABS_CTRL 2
*OFF_F 0.2
*ON_F 0.15
*V_F 6
ABS_SLIP_OFF 0.2
ABS_SLIP_ON 0.15
ABS_VMIN 6

iside 2
symbol_set <<side>> R
TLAG_BK 0
*P_L1 1
PBK_DL_COEFFICIENT 1
PBK_DL_COMBINE MULTIPLY
PBK_DL_FZ_CONSTANT 1
TC_L1 0.06
TC_BK 0.06
OPT_BK_DYN 1
*TQ_L1 500
MY_BRAKE_COEFFICIENT 500

iaxle 2
iside 1
symbol_add <<ax_bk>> 1
symbol_set <<side>> L
TLAG_BK 0
*P_L2 1
PBK_DL_COEFFICIENT 1
PBK_DL_COMBINE MULTIPLY
PBK_DL_FZ_CONSTANT 1
TC_L2 0.06
TC_BK 0.06
OPT_BK_DYN 1
*TQ_L2 250
MY_BRAKE_COEFFICIENT 250

OPT_ABS_CTRL 2
*OFF_R 0.2
*ON_R 0.15
*V_R 6
ABS_SLIP_OFF 0.2
ABS_SLIP_ON 0.15
ABS_VMIN 6

iside 2
symbol_set <<side>> R
TLAG_BK 0
*P_L2 1
PBK_DL_COEFFICIENT 1
PBK_DL_COMBINE MULTIPLY
PBK_DL_FZ_CONSTANT 1
TC_L2 0.06
TC_BK 0.06
OPT_BK_DYN 1
*TQ_L2 250
MY_BRAKE_COEFFICIENT 250

LOG_ENTRY Used Dataset: Brakes: Four-Wheel System; { Pickup Trucks and SUVs } SUV, Full Size w/ ABS
#Library : Brakes: Four-Wheel System
#DataSet : SUV, Full Size w/ ABS
#Category: Pickup Trucks and SUVs
#FileID  : Brk4W_ce25937f-c145-44ac-952a-8f974831b753
#Product : CarSim 2017.1
#VehCode 4-Wheel System

END
