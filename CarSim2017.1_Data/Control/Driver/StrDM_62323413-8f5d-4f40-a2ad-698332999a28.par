#CheckBox1 1    
CREATE_PATH_OBJ on
#CheckBox2 0    

#RingCtrl0 0
#RingCtrl1 CONSTANT
LTARG_CONSTANT 0
#RadioCtrl0 0    

AV_SW_MAX_DM 1200
TLAG_DM 0
A_SW_MAX_DM 720
*TPREV 0.5
*GAIN 0
*SCALAR 0
VLOW_DRIVER 20
SET_PATH_WIDTH 0.05
