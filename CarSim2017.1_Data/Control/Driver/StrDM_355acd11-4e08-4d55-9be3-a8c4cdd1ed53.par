PARSFILE
#FullDataName Control: Steering by the Closed-loop Driver Model`Go to Right 1m, dS = 2m`Lane Changes
#CheckBox0 0    
OPT_DRIVER_MODEL 1
#CheckBox1 0    
CREATE_PATH_OBJ off
#CheckBox2 0    

#RingCtrl0 0
#RingCtrl1 SPLINE_FLAT
#DiagramOne0
LTARG_TABLE SPLINE_FLAT
