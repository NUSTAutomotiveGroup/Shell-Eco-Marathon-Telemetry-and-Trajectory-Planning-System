PARSFILE
#FullDataName Positions, Velocities, and Accelerations`Front LCA`LCA Sub-compact
#RingCtrl0 0
#RingCtrl2 2
#RingCtrl3 1
#RingCtrl4 1
#RingCtrl5 1
#RingCtrl6 1
#RingCtrl7 1
*BODY_ID_1 1
*X_S1 0
*Y_S1 330
*Z_S1 280
*A_ROLL_S1 0
*A_PITCH_S1 0
*A_YAW_S1 0
*BODY_ID_2 1
*X_S2 0
*Y_S2 -330
*Z_S2 280

ISENSOR_M = 1
DEFINE_MOTION_SENSORS 2 + ISENSOR_M -1 -NSENSOR_M

OPT_S_BODY_TYPE 1
OPT_S_OUTPUT 1
OPT_S_BODY_ID 1
X_S 0
Y_S 330
Z_S 280
A_ROLL_S 0
A_PITCH_S 0
A_YAW_S 0
SET_DESCRIPTION MOTION_SENSOR_NAME Sensor 1: Front LCA

ISENSOR_M = ISENSOR_M + 1
OPT_S_BODY_TYPE 1
OPT_S_OUTPUT 1
OPT_S_BODY_ID 1
X_S 0
Y_S -330
Z_S 280
SET_DESCRIPTION MOTION_SENSOR_NAME Sensor 2: Front LCA

MAKE_MOTION_SENSOR_OUTPUTS

#EMBEDDED_NOTES
#This dataset adds output variables for the global position of the aerodynamic reference point.
#
#By entering symbolic names for the coordinates of the aerodynamic reference point, this dataset is "portable"; that is, it works for any vehicle and any location of the aerodynamic reference point.
#END_EMBEDDED_NOTES

LOG_ENTRY Used Dataset: Positions, Velocities, and Accelerations; { LCA Sub-compact } Front LCA
