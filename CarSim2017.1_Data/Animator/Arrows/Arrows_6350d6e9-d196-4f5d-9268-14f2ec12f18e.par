PARSFILE
#FullDataName Animator: Wheel Arrows and Other Indicators`Tire Skid Marks (2 Axles) w/ Three Payloads`Tire Paths (2 Axle)
#CheckBox0 0    
#CheckBox1 1    
#CheckBox4 0    

#RingCtrl0 2
#RingCtrl1 T
#RingCtrl2 B
#RingCtrl3 0
*VISIBLE_NAME Fz_?
*ALPHA_NAME TmTrl_?
*DYN_X TMLen_?
*REF_X 1
*OFFSET_Z 0.055
*ID_AXLE 1

#MiscYellow0
default_ghost off ! disable ghosts for vehicle
ghost_count 250 ! number of markers
ghost_period -0.05
DEFINE_PARAMETER TireMarkLen = 0.06 ; m; Length of tire marks
DEFINE_VARIABLE FzAvg = (M_SU + M_US(1) + M_US(2) + M_PL(1) + M_PL(2) + M_PL(3)) / 6 ; ; Ave for 2-axle vehicle, three payloads
DEFINE_PARAMETER TireMarkOffset = 0.0 ; ; Overall darkness of tire marks
DEFINE_PARAMETER TireMarkScale = 1.0  ; ; Overall darkness of tire marks
#ENDMYellow

#MiscYellow1
#reference_frame_ghosts on
#DEFINE_OUTPUT VYaw_? =  IF_GT_0_THEN(VxCen?, Yaw_? + Alpha_?, pi + Yaw_? -Alpha_?); deg ; Tire mark ? yaw
#DEFINE_OUTPUT TMLen_? = SQRT(VyTC_?^2 + VxCen?^2) * TireMarkLen; m ; Tire mark ?  length
#DEFINE_OUTPUT TmTrl_? = min(1.0, TireMarkOffset + (TireMarkScale * 0.001 * (Fz_? / FzAvg) * sqrt(((VxCen? - Vx_?)^2) + (VyTC_?^2)))) ; - ; ...
#    ; Tire mark ?  translucency
#SET_YAW_NAME VYaw_?
#WRT_VYaw_?
#ANI_VYaw_?
#ENDMYellow

#BlueLink0 Animator: Shape File Link`Skid Mark, Black` Tires` , Animator Shape(s)`Shape_cbeb61e2-0787-4c7e-b4d8-b6e0b7f413d9

ADD_REFERENCE_FRAME wheel L1 indicator: Tire Skid Marks (2 Axles) w/ Three Payloads
PARSFILE Animator\STL\Shape_cbeb61e2-0787-4c7e-b4d8-b6e0b7f413d9.par
SET_EULER_ANGLES yaw_pitch_roll
SET_X_NAME Xctc_L1
WRT_Xctc_L1
ANI_Xctc_L1
SET_Y_NAME Yctc_L1
WRT_Yctc_L1
ANI_Yctc_L1
SET_Z_NAME Zgnd_L1
WRT_Zgnd_L1
ANI_Zgnd_L1
SET_PITCH_NAME PitchGL1
WRT_PitchGL1
ANI_PitchGL1
SET_ROLL_NAME RollGL1
WRT_RollGL1
ANI_RollGL1
SET_YAW_NAME Yaw_L1
WRT_Yaw_L1
ANI_Yaw_L1
reference_frame_ghosts on
DEFINE_OUTPUT VYaw_L1 =  IF_GT_0_THEN(VxCenL1, Yaw_L1 + Alpha_L1, pi + Yaw_L1 -Alpha_L1); deg ; Tire mark L1 yaw
DEFINE_OUTPUT TMLen_L1 = SQRT(VyTC_L1^2 + VxCenL1^2) * TireMarkLen; m ; Tire mark L1  length
DEFINE_OUTPUT TmTrl_L1 = min(1.0, TireMarkOffset + (TireMarkScale * 0.001 * (Fz_L1 / FzAvg) * sqrt(((VxCenL1 - Vx_L1)^2) + (VyTC_L1^2)))) ; - ; ...
    ; Tire mark L1  translucency
SET_YAW_NAME VYaw_L1
WRT_VYaw_L1
ANI_VYaw_L1

SET_FRAME_SCALE_X_NAME TMLen_L1
WRT_TMLen_L1
ANI_TMLen_L1
X_REF_LENGTH 1
X_LENGTH 1
Y_LENGTH 1
Z_LENGTH 1
SET_OFFSET_VAR_Z 0.055
SET_FRAME_VISIBLE_NAME Fz_L1
WRT_Fz_L1
ANI_Fz_L1
REFERENCE_FRAME_ALPHA_NAME TmTrl_L1
WRT_TmTrl_L1
ANI_TmTrl_L1

