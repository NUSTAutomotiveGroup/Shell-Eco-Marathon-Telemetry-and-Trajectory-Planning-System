PARSFILE
#FullDataName Animator: Shape File Link`Transverse Transmission`Engine Mount
#MiscYellow3
add_obj Animator\3D_shape_files_CS\transmissions\Transverse\Transverse_trans.obj
#ENDMYellow

SET_COLOR 1 1 1
SET_ANGLE_Z 0
SET_ANGLE_Y 0
SET_ANGLE_X 0
SET_OFFSET_X 0
