*IMAGE_FIT_MODE 1
#CheckBox0 0    
set_lighting on
#CheckBox1 0    
set_fogging on
#CheckBox3 0    
#CheckBox4 1    

SET_SPECULAR 1 1 1
vsv_enable_shadows_recursive

SPECIAL_PARSFILE Animator\Cameras\Camera_a950d52f-1ae4-4b4f-bf7e-869467881259.par
#BlueLink2 Animator: Camera Setup`Shape Preview (Top) No Offset` Shape Preview` , Video Camera`Camera_a950d52f-1ae4-4b4f-bf7e-869467881259

