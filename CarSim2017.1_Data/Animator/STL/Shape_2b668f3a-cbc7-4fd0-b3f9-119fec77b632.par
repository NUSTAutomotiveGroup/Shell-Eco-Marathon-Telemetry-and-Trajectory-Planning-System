PARSFILE
#FullDataName Animator: Shape File Link`Pickup, Compact: Driver`CS Pickup, Compact
#MiscYellow3
add_obj Animator\3D_shape_files_CS\Driver\driver.obj
#ENDMYellow

SET_COLOR 1 1 1
SET_SCALE_X 1
SET_SCALE_Y 1
SET_SCALE_Z 1.2
SET_OFFSET_X 0.05
SET_OFFSET_Y 0
SET_OFFSET_Z 0
*SPECULAR 0
*IMAGE_FIT_MODE 1
#CheckBox0 0    
set_lighting on
#CheckBox1 0    
set_fogging on
#CheckBox3 0    
#CheckBox4 1    

SET_SPECULAR 0 0 0
vsv_enable_shadows_recursive

