SOUND_AUTO_START Default
SOUND_VOL_MULT 0.3
SOUND_VOL_MIN 0.01
SOUND_VOL_MAX 9.0
SOUND_FREQ_MULT 1.0
SOUND_FREQ_MIN 0.01
SOUND_FREQ_MAX 9.0
ENTER_PARSFILE Animator\Sound\Modifier\SndMod_59e0531b-dd39-45ad-ba0e-7a1d650b1244.par`03-29-2017`11:41:24
#FullDataName Animator: Sound Modifier`Loudness: Speed Effect`Wind
define_parameter air_speed_ref 50; km/h; Reference speed for wind audio
define_output v_mod3 = pow(vAir/air_speed_ref, 3.0); ; Audio control, wind speed, vol
ADD_SOUND_MODIFIER VOLUME
SOUNDMOD_OPERATION mult
SOUNDMOD_INPUT_NAME v_mod3
SOUNDMOD_INPUT_MIN 0.0
SOUNDMOD_INPUT_LOW 1.0
SOUNDMOD_INPUT_HIGH 2.0
SOUNDMOD_INPUT_MAX 3.0
SOUNDMOD_OUTPUT_MIN 0.0
SOUNDMOD_OUTPUT_LOW 1.0
SOUNDMOD_OUTPUT_HIGH 2.0
SOUNDMOD_OUTPUT_MAX 3.0
WRT_v_mod3
ANI_v_mod3
LOG_ENTRY Used Dataset: Animator: Sound Modifier; { Wind } Loudness: Speed Effect
EXIT_PARSFILE Animator\Sound\Modifier\SndMod_59e0531b-dd39-45ad-ba0e-7a1d650b1244.par

ENTER_PARSFILE Animator\Sound\Modifier\SndMod_6c2f9d3c-2cd8-4a47-8c30-a4cac11ee2de.par`03-29-2017`11:41:24
#FullDataName Animator: Sound Modifier`Frequency: Speed Effect`Wind
define_output v_mod4 = pow(vAir/air_speed_ref, 0.5); ; Audio control, wind speed, freq
ADD_SOUND_MODIFIER FREQUENCY
SOUNDMOD_OPERATION mult
SOUNDMOD_INPUT_NAME v_mod4
SOUNDMOD_INPUT_MIN 0.0
SOUNDMOD_INPUT_LOW 1.0
SOUNDMOD_INPUT_HIGH 2.0
SOUNDMOD_INPUT_MAX 3.0
SOUNDMOD_OUTPUT_MIN 0.0
SOUNDMOD_OUTPUT_LOW 0.5
SOUNDMOD_OUTPUT_HIGH 1.0
SOUNDMOD_OUTPUT_MAX 1.5
WRT_v_mod4
ANI_v_mod4
LOG_ENTRY Used Dataset: Animator: Sound Modifier; { Wind } Frequency: Speed Effect
EXIT_PARSFILE Animator\Sound\Modifier\SndMod_6c2f9d3c-2cd8-4a47-8c30-a4cac11ee2de.par

