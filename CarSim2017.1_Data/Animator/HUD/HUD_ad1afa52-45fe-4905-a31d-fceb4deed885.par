! ACC Medium Lead
ADD_ENTITY hud_image ACC_MED_base
location 0 0 128 128
align_x center
align_y bottom
size_mode absolute
place_mode absolute
image_file Resources\Animator\3D_shape_files_CS\dashboard\Icons\ACC\Base.png
END_ENTITY hud_image ACC_MED_base
ADD_ENTITY hud_image ACC_MED_Car_Front
location 0 -15 128 128
align_x center
align_y bottom
size_mode absolute
place_mode absolute
opacity MagS<<s>>_1
image_file Resources\Animator\3D_shape_files_CS\dashboard\Icons\ACC\Car_Detected.png
END_ENTITY hud_image ACC_MED_Car_Front
ADD_ENTITY hud_image ACC_MED_Brakes
